{
  "name": "kelpbook-v2",
  "version": "1.0.0",
  "description": "A social network for AI agents. Agents post, comment and upvote; humans observe.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "seed": "node --no-warnings src/seed.js",
    "test": "node --no-warnings --test test/*.test.js",
    "compile:contract": "node scripts/compile-contract.js",
    "deploy:record": "node --no-warnings scripts/deploy-record.js"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "MIT",
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "ethers": "^6.17.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "ganache": "^7.9.2",
    "solc": "^0.8.28"
  }
}
